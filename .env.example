ANTHROPIC_API_KEY=
# Required only for identity-linked API keys; find it in the Anthropic Console under Settings -> Workspaces
ANTHROPIC_WORKSPACE_ID=
# Optional model override for extraction (defaults in code)
# ANTHROPIC_MODEL=
# Optional judge model override (defaults to claude-sonnet-5)
# CLEARPATH_JUDGE_MODEL=
# Demo deployments only: 1 enables the public demo-reset endpoint (any visitor
# can wipe the DB) — never set on a real deployment. See DEPLOY.md.
# CLEARPATH_DEMO=
